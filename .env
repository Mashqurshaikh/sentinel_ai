# Copy this file to ".env" (same folder) and paste your real keys in.
# ".env" is already ignored by git, so your keys never get committed.
#
# You only need the keys for the providers you actually want to use.
# Any provider left blank will simply show as "(no key)" in the app.

ANTHROPIC_API_KEY=sk-ant-your-claude-key-here
OPENAI_API_KEY=sk-your-chatgpt-key-here
GOOGLE_API_KEY=your-gemini-key-here
